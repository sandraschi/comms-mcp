{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 5am on monday"],
  "stabilityDays": 3,
  "prConcurrentLimit": 3,
  "packageRules": [
    {
      "matchManagers": ["pep621", "pip_requirements"],
      "groupName": "python deps"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "web deps"
    },
    {
      "matchPackageNames": ["fastmcp"],
      "description": "FastMCP floor is pinned fleet-wide; review manually",
      "enabled": false
    }
  ]
}
