# Telegram (v0.1) - get a token from @BotFather
COMMS_TELEGRAM_BOT_TOKEN=
# Comma-separated chat-id allowlist (send is blocked outside this list)
COMMS_TELEGRAM_CHAT_IDS=
# Optional overrides
# COMMS_TELEGRAM_API_BASE=https://api.telegram.org
# COMMS_DB_PATH=data/comms.db
# COMMS_RETENTION_DAYS=7

# WhatsApp (v0.2, via Node baileys sidecar on :11032)
COMMS_WHATSAPP_SIDECAR_URL=http://127.0.0.1:11032
# Comma-separated E.164 numbers allowed to receive sends
COMMS_WHATSAPP_ALLOW_NUMBERS=

# Slack (v0.3, official SDK, Socket Mode - no sidecar)
# App-level token (xapp-*) + Bot token (xoxb-*); enable Socket Mode in the app
COMMS_SLACK_APP_TOKEN=
COMMS_SLACK_BOT_TOKEN=
# Comma-separated channel allowlist (e.g. C123ABC)
COMMS_SLACK_CHANNEL_IDS=
